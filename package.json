{
  "name": "azure-blob-trigger",
  "version": "1.0.0",
  "description": "Fluent TypeScript helpers for Azure Functions v4 Storage Blob triggers with extension filtering and multi-output bindings.",
  "keywords": [
    "azure",
    "azure-functions",
    "blob",
    "storage",
    "trigger",
    "typescript",
    "fluent-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurylloEx/azure-blob-trigger.git"
  },
  "bugs": {
    "url": "https://github.com/MurylloEx/azure-blob-trigger/issues"
  },
  "homepage": "https://github.com/MurylloEx/azure-blob-trigger#readme",
  "author": "Muryllo Pimenta de Oliveira",
  "license": "MIT",
  "main": "dist/functions.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "host.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "prestart": "npm run build",
    "start": "func start",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.jest.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}
